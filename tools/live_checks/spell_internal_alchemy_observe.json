   },
   {
    "verb": "grant_runes",
    "runes": {
     "Nature": 10
    }
   },
   {
    "verb": "grant",
    "item": "ITEM_Consumable_Bread",
    "count": 1
   }
  ],
  "set_health": {
   "pct": 100
  },
  "input_mode": "DIM_Gameplay"
 },
 "steps": [
