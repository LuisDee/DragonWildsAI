{
 "id": "spell_trunk_totem_observe",
 "owner": "spells (M2 gap audit)",
 "area": "client_mod/scripts/spells.lua cast (placed) + DevTarget felled_log fixture (UNVERIFIED)",
 "why": "Trunk Totem has no observed effect (needs_live_observation; 'piles scattered trunks'). A felled log nearby (felled_log fixture), cast in front of him: record the spell actor and the logs before/after.",
 "observe_only": true,
 "preconditions": {
  "fixtures": [
   {
    "verb": "unlock",
    "spell": "USD_PileEmUp"
   },
   {
    "verb": "grant_runes",
    "runes": {
     "Law": 10,
     "Nature": 30
    }
   },
   {
    "verb": "felled_log",
    "as": "log",
    "at": [
     4,
     0,
     0
    ]
   }
  ],
  "set_health": {
   "pct": 100
  },
  "input_mode": "DIM_Gameplay"
 },
 "steps": [
  {
   "probe": true,
   "save": "start"
  },
  {
   "bridge": "look",
   "args": {
    "about": "log",
    "radius": 15,
    "max": 15
   },
   "timeout_s": 15,
   "save": "look"
  },
  {
   "bridge": "cast",
   "args": {
    "spell": "Trunk Totem"
   },
   "timeout_s": 60,
   "save": "cast"
  },
  {
   "sleep_s": 5
  },
  {
   "bridge": "look",
   "args": {
    "about": "log",
    "radius": 20,
    "max": 15
   },
   "timeout_s": 15,
   "save": "look_after"
  },
  {
   "probe": true,
   "save": "end"
  }
 ],
 "pass": [
  {
   "ref": "cast.ok",
   "eq": true
  },
  {
   "ref": "cast.data.spell_actor",
   "exists": true
  }
 ],
 "observe": [
  "cast.ok",
  "cast.reason",
  "cast.data.why",
  "cast.data.detail",
  "cast.data.runes_spent",
  "cast.data.cooldown_started",
  "cast.data.effects",
  "cast.data.effect_verified",
  "cast.data.spell_actor",
  "cast.data.landed_at",
  "cast.data.moved_m",
  "look.data.things",
  "look_after.data.things"
 ],
 "timeout_s": 300,
 "max_retries": 0
}
