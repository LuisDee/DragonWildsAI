{
 "id": "spell_enfeeble_observe",
 "owner": "spells (M2 gap audit)",
 "area": "client_mod/scripts/spells.lua cast (aimed at a creature) + target_effects read",
 "why": "Enfeeble has no observed effect (needs_live_observation; dump hypothesis: GE_Enfeeble_C on the target). One runt goblin: record what lands on it.",
 "observe_only": true,
 "preconditions": {
  "fixtures": [
   {
    "verb": "unlock",
    "spell": "USD_Enfeeble"
   },
   {
    "verb": "grant_runes",
    "runes": {
     "Water": 20,
     "Astral": 20
    }
   },
   {
    "verb": "spawn",
    "class": "BP_AI_RuntGoblin_Character_C",
    "offset_m": [
     14,
     0,
     0
    ]
   }
  ],
  "set_health": {
   "pct": 100
  },
  "input_mode": "DIM_Gameplay"
 },
 "steps": [
  {
   "probe": true,
   "save": "start"
  },
  {
   "bridge": "look",
   "args": {
    "about": "goblin",
    "radius": 30,
    "max": 15
   },
   "timeout_s": 15,
   "save": "look"
  },
  {
   "bridge": "cast",
   "args": {
    "spell": "Enfeeble",
    "target": {
     "$find": {
      "in": "look.data.things",
      "match": {
       "name": "goblin"
      },
      "get": "id"
     }
    }
   },
   "timeout_s": 60,
   "save": "cast"
  },
  {
   "probe": true,
   "save": "end"
  }
 ],
 "pass": [
  {
   "ref": "cast.ok",
   "eq": true
  },
  {
   "ref": "cast.data.target_effects.ge",
   "truthy": true,
   "why": "a status GE landed on the creature"
  }
 ],
 "observe": [
  "cast.ok",
  "cast.reason",
  "cast.data.why",
  "cast.data.detail",
  "cast.data.runes_spent",
  "cast.data.cooldown_started",
  "cast.data.effects",
  "cast.data.effect_verified",
  "cast.data.spell_actor",
  "cast.data.landed_at",
  "cast.data.moved_m",
  "cast.data.target_effects",
  "cast.data.target_health"
 ],
 "timeout_s": 240,
 "max_retries": 0
}
