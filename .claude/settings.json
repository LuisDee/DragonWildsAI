{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe tools/hooks/judge_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
